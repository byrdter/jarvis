#!/bin/bash
# JARVIS Market Data CLI Wrapper
# Activates venv and runs jarvis-price command

# Resolve symlinks so this works when invoked via ~/bin/jarvis-price.
# (Before 2026-08-02 this used dirname "$BASH_SOURCE" directly, which resolved to
#  the symlink's directory and looked for the venv under ~/bin/market-data.)
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    LINK="$(readlink "$SELF")"
    case "$LINK" in
        /*) SELF="$LINK" ;;
        *)  SELF="$(dirname "$SELF")/$LINK" ;;
    esac
done
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
VENV_DIR="$SCRIPT_DIR/market-data/.venv"

if [ ! -d "$VENV_DIR" ]; then
    echo "Error: Virtual environment not found at $VENV_DIR" >&2
    echo "Run: cd $SCRIPT_DIR/market-data && uv pip install -e ." >&2
    exit 1
fi

source "$VENV_DIR/bin/activate"
jarvis-price "$@" 2>&1 | grep -v "Pandas4Warning"
