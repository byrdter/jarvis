{
  "bypassPermissions": true,
  "env": {
    "enableToolSearch": true
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bash .claude/hooks/save-session-state.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash .claude/hooks/restore-session-state.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash .claude/hooks/smart-recall.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "model": "claude-sonnet-4-5-20250929",
  "outputStyle": ".claude/output-style.md"
}