# ~/.config/jarvis/jobs.env on the server. Change JARVIS_TZ when Terry travels
# (e.g. America/Chicago); every job follows it.
JARVIS_TZ=Europe/Madrid
ACTIVE_START=10
ACTIVE_END=19
BRIEF_HOUR=10
PREFLIGHT_HOUR=9
GITHUB_USER=byrdter
# Daily intake (collect + curate) runs at this local hour, ready for the brief.
COLLECT_HOUR=7
# Inbox day folders older than this are deleted.
INBOX_DAYS=30
